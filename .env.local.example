# Supabase Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app URL (set to https://bukworm.onrender.com in production)
NEXT_PUBLIC_SITE_URL=

# Supabase Private
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Optional: overrides the Gemini key globally for all users.)
GOOGLE_GEMINI_API_KEY=

# General Configuration (Optional)
EMAIL_DOMAIN_WHITELIST=
EMAIL_WHITELIST=

# File size limit for uploads in bytes
NEXT_PUBLIC_USER_FILE_SIZE_LIMIT=10485760