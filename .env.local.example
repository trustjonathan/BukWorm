# Supabase Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Private
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Optional: overrides the Gemini key globally for all users.)
GOOGLE_GEMINI_API_KEY=

# GIPHY (Optional: enables GIF and sticker search in shared workspaces.)
GIPHY_API_KEY=

# General Configuration (Optional)
EMAIL_DOMAIN_WHITELIST=
EMAIL_WHITELIST=

# File size limit for uploads in bytes
NEXT_PUBLIC_USER_FILE_SIZE_LIMIT=10485760